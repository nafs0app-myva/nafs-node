PORT=43125
NODE_ENV=development

# Use 127.0.0.1 (TCP). On XAMPP Windows use localhost + XAMPP MySQL port (usually 3306).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nafs
DB_PASSWORD=nafs_pass
DB_NAME=nafs

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

APP_NAME=Nafs
APP_URL=http://127.0.0.1:43125

# Remote migrate/seed: POST /api/v1/admin/db-setup with header X-Setup-Key
SETUP_KEY=

# SMTP for verification / forgot-password emails (optional — without these, emails are logged to email_outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nafs <noreply@nafs.app>

# Optional: used by scripts/fetch-figma.js to sync screen inventory
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=tkBoHPyvyuhwBW3rvjPMtN

# Push notifications (Firebase Cloud Messaging HTTP v1) - service account JSON, base64 JSON, or a file path
FCM_SERVICE_ACCOUNT=
FCM_SERVICE_ACCOUNT_FILE=

# SMS notifications (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Timezone used to format times for users without a profile timezone
APP_TIMEZONE=Asia/Riyadh

# Card payments (Moyasar) - leave empty to run without payments (dev confirms booking free)
MOYASAR_SECRET_KEY=
# Optional: shared secret checked on POST /payments/webhook (X-Moyasar-Token)
MOYASAR_WEBHOOK_SECRET=
# Client checkout service fee % (Figma: session + service fee = total). Default 5.
CLIENT_SERVICE_FEE_PERCENT=5
# Therapist platform fee % retained by NAFS. Default 15.
FEE_PERCENT=15

SUPPORT_EMAIL=support@nafs.app

# Agora RTC token minting for calls (leave empty to return no token)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
