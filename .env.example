PORT=43125
NODE_ENV=development

# Use 127.0.0.1 (TCP). On XAMPP Windows use localhost + XAMPP MySQL port (usually 3306).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nafs
DB_PASSWORD=nafs_pass
DB_NAME=nafs

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

APP_NAME=Nafs
APP_URL=http://127.0.0.1:43125

# Remote migrate/seed: POST /api/v1/admin/db-setup with header X-Setup-Key
SETUP_KEY=

# SMTP for verification / forgot-password emails (optional — without these, emails are logged to email_outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nafs <noreply@nafs.app>

# Optional: used by scripts/fetch-figma.js to sync screen inventory
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=tkBoHPyvyuhwBW3rvjPMtN
