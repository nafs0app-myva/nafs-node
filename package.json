{
  "name": "nafs-api",
  "version": "1.0.0",
  "description": "Nafs mobile backend — Node.js + MySQL REST APIs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js",
    "figma:fetch": "node scripts/fetch-figma.js"
